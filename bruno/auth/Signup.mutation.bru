meta {
  name: Signup
  type: graphql
  seq: 1
}

post {
  url: http://localhost:4000/graphql
  body: graphql
  auth: none
}

body:graphql {
  mutation Signup($input: SignupInput!) {
    signup(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "fullName": "Test User",
      "email": "test@example.com",
      "mobileNumber": "1234567890",
      "password": "Password@123",
      "confirmPassword": "Password@123"
    }
  }
}
