meta {
  name: ForgotPassword
  type: graphql
  seq: 3
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation ForgotPassword($input: ForgotPasswordInput!) {
    forgotPassword(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "yes20sh@gmail.com"
    }
  }
}

vars:pre-request {
  graphqlUrl: http://localhost:4000/graphql
}
