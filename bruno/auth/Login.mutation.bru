meta {
  name: Login
  type: graphql
  seq: 2
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation Login($input: LoginInput!) {
    login(input: $input) {
      accessToken
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "test@example.com",
      "password": "password123"
    }
  }
}
