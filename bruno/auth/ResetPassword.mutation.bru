meta {
  name: ResetPassword
  type: graphql
  seq: 4
}

post {
  url: {{graphqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation ResetPassword($input: ResetPasswordInput!) {
    resetPassword(input: $input)
  }
}

body:graphql:vars {
  {
    "input": {
      "email": "test@example.com",
      "otp": "123456",
      "newPassword": "newpassword123",
      "confirmPassword": "newpassword123"
    }
  }
}
